# Independent AI Screen Validation Configuration
# Add these settings to your .env file to use Ollama-based validation

# ============================================================
# SCREEN VALIDATION PROVIDER SELECTION
# ============================================================

# Choose your provider:
#   'ollama'  -> Local, free, independent (RECOMMENDED)
#   'gemini'  -> Cloud, requires API key
#   'hybrid'  -> Try Ollama first, fallback to Gemini
#   'legacy'  -> Pixel-based validation (fallback)

SCREEN_VALIDATION_PROVIDER=ollama

# ============================================================
# OLLAMA CONFIGURATION (For Local Independent AI)
# ============================================================

# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Vision model name
# Options: llava (recommended), llava-phi, bakllava
OLLAMA_MODEL=llava

# Timeout for Ollama requests (seconds)
OLLAMA_TIMEOUT=60

# ============================================================
# GEMINI CONFIGURATION (Cloud-based Alternative - Optional)
# ============================================================

# Only needed if using 'gemini' or 'hybrid' provider
# Get free API key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Vision model (default: gemini-2.0-flash)
GEMINI_VISION_MODEL=gemini-2.0-flash

# ============================================================
# HYBRID MODE SETTINGS (If using 'hybrid' provider)
# ============================================================

# Confidence threshold to trigger fallback to Gemini (0.0-1.0)
# Default: 0.5 (50% - if Ollama is less than 50% confident, try Gemini)
HYBRID_FALLBACK_THRESHOLD=0.5

# ============================================================
# VALIDATION SETTINGS
# ============================================================

# Minimum confidence for screen match (0.0-1.0)
# Higher value = stricter matching
SCREEN_MATCH_CONFIDENCE_THRESHOLD=0.6

# Fallback to legacy pixel-based validation if AI fails
FALLBACK_TO_LEGACY_VALIDATION=true

# ============================================================
# DEBUG & LOGGING
# ============================================================

# Enable debug logging for screen validation
DEBUG_SCREEN_VALIDATION=false

# Save validation analysis reports
SAVE_VALIDATION_REPORTS=false

# Directory for validation reports
VALIDATION_REPORT_DIR=Enhancement_output/validation_reports

# ============================================================
# QUICK START COMMANDS
# ============================================================

# 1. Install Ollama (one-time):
#    Linux:   curl https://ollama.ai/install.sh | sh
#    macOS:   brew install ollama
#    Windows: Download from https://ollama.ai
#
# 2. Download vision model (one-time):
#    ollama pull llava
#
# 3. Start Ollama server (before running tests):
#    ollama serve
#
# 4. Verify Ollama is running:
#    curl http://localhost:11434/api/tags
#
# 5. Set this configuration:
#    SCREEN_VALIDATION_PROVIDER=ollama
#
# 6. Test it works:
#    python3 -c "from services.unified_screen_validator import UnifiedScreenValidator; v = UnifiedScreenValidator(); print('✅ Ready' if v.get_provider_info()['available'] else '❌ Not available')"
