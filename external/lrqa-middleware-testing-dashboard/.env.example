# Gmail App Password Instructions:
# 1. Enable 2-Step Verification on your Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app password for "Mail" 
# 4. Copy the 16-character password (remove spaces)
# 5. Paste it as SENDER_PASSWORD above
# 6. Never commit the actual .env file with real passwords!

# Application Settings
# SECRET_KEY should be a long random string in production
# You can generate one using: python -c "import secrets; print(secrets.token_hex(32))"

# ============================================================
# PostgreSQL Database Configuration (v2.0)
# ============================================================
# DATABASE CREDENTIALS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lrqa_v2
DB_USER=lrqa
DB_PASSWORD=your-secure-password-here

# CONNECTION POOL SETTINGS
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_PRE_PING=true
DB_ECHO=false

# ============================================================
# AI Screen Analyzer (Google Gemini Vision API - FREE TIER - v2.0)
# ============================================================
