# - Video, audio, and text analysis included
GOOGLE_API_KEY=AIzaSyDxxxxx-your-free-key-here

# ============================================================
# Deployment Configuration (v2.0)
# ============================================================
DEPLOYMENT_LOCATION=primary
TEAM_NAME=QA-Team
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
GUNICORN_WORKERS=4
LOG_LEVEL=INFO

# ============================================================
# Feature Flags (v2.0)
# ============================================================
ENABLE_AI_SCREEN_ANALYZER=true
ENABLE_AGENT_FRAMEWORK=true
ENABLE_DISTRIBUTED_SYNC=false
