# --- Slack Notifications (V2.0 Global) ---
# Required: Slack bot token (chat.postMessage scope). Same token as device-health-dashboard.
SLACK_BOT_TOKEN=
# Channel that receives job notifications for the V2.0 app
SLACK_CHANNEL=desk_automation_v2
SLACK_DEBUG_CHANNEL=desk_automation_v2_dev
# Feature toggles
SLACK_ENABLED=true
SLACK_NOTIFY_ON_START=true
SLACK_NOTIFY_ON_COMPLETE=true
SLACK_NOTIFY_ON_FAILURE=true
SLACK_NOTIFY_ON_CANCEL=true
# Dashboard link used in messages
DASHBOARD_BASE_URL=http://10.26.52.151:11079
