# Copy to .device-data.env on each Pi and set absolute paths to that Pi's own files.
# Keep this file private and never point multiple Pi instances at the same files.
APP_DEVICES_FILE=/home/your-service-user/.local/share/lrqa-automation/devices.json
APP_USERS_FILE=/home/your-service-user/.local/share/lrqa-automation/users.json
