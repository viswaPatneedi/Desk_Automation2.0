# Enhanced Dockerfile with scalability improvements
FROM python:3.11-slim

WORKDIR /app

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_APP=app.py \
    FLASK_ENV=production \
    # Increase file descriptor limits for SSH connections
    ULIMIT_NOFILE=4096

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    gcc \
    redis-tools \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir redis filelock

# Copy application
COPY . .

# Create directories
RUN mkdir -p iteration_logs screenshots

# Set file descriptor limits
RUN ulimit -n 4096

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5000/health', timeout=5)" || exit 1

# Enhanced Gunicorn configuration for 15+ users
# Formula: (2 x CPU cores) + 1, but we'll use more for I/O-bound operations
CMD ["gunicorn", \
    "--bind", "0.0.0.0:5000", \
    "--workers", "8", \
    "--worker-class", "gevent", \
    "--worker-connections", "1000", \
    "--timeout", "300", \
    "--keep-alive", "5", \
    "--max-requests", "1000", \
    "--max-requests-jitter", "50", \
    "--access-logfile", "-", \
    "--error-logfile", "-", \
    "--log-level", "info", \
    "app:app"]
