# Multi-stage optimized Dockerfile for Windows, Mac, and Linux
# Optimized for cross-platform compatibility and smaller image size
# Supports both AMD64 and ARM64 (Apple Silicon M1/M2/M3)

# Stage 1: Builder
FROM python:3.11-slim as builder

# Set environment variables for build stage
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements early for better Docker layer caching
COPY requirements.txt .

# Create virtual environment in builder stage
RUN python -m venv /app/venv && \
    /app/venv/bin/pip install --upgrade pip setuptools wheel && \
    /app/venv/bin/pip install -r requirements.txt

# Stage 2: Runtime
FROM python:3.11-slim

# Metadata for image
LABEL maintainer="RDK Testing Dashboard"
LABEL description="Flask-based RDK Testing Dashboard with SSH device management, AI vision, and logging"

# Set working directory
WORKDIR /app

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_APP=app.py \
    FLASK_ENV=production \
    VIRTUAL_ENV=/app/venv \
    PATH="/app/venv/bin:$PATH" \
    # Performance optimization for container environments
    PYTHONHASHSEED=random \
    # Prevent Python from writing pyc files
    PYTHONWRITEBYTECODE=0

# Install runtime dependencies only (smaller image than builder stage)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder stage
COPY --from=builder /app/venv /app/venv

# Copy application code
COPY . .

# Create necessary runtime directories
RUN mkdir -p iteration_logs screenshots && \
    chmod -R 755 iteration_logs screenshots

# Email service environment variables (can be overridden at runtime)
ENV SMTP_HOST=smtp.gmail.com \
    SMTP_PORT=587 \
    SENDER_EMAIL=cperdkemiddleware@gmail.com \
    SENDER_PASSWORD="" \
    SECRET_KEY=change-me-in-production

# Expose port 5000 for Flask application
EXPOSE 5000

# Health check to ensure container is running properly
# Using curl instead of Python to reduce overhead
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Run the application with Gunicorn (production WSGI server)
# Worker configuration: 4 workers (adjust based on available cores)
# Timeout: 300 seconds for long-running operations
# Access/error logs to stdout for container logs
CMD ["gunicorn", \
     "--bind", "0.0.0.0:5000", \
     "--workers", "4", \
     "--worker-class", "gevent", \
     "--timeout", "300", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--log-level", "info", \
     "app:app"]
