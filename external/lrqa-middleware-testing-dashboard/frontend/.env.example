# Frontend Environment Configuration
# Copy this to .env.local and update values for your environment

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000

# WebSocket Configuration
VITE_WS_URL=http://localhost:5000
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10

# Feature Flags
VITE_ENABLE_LOGGING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_TRACKING=true

# UI Configuration
VITE_MODAL_ANIMATION_DURATION=300
VITE_TOAST_AUTO_CLOSE_DURATION=5000

# Authentication
VITE_AUTH_TOKEN_KEY=lrqa_auth_token
VITE_AUTH_REFRESH_BEFORE_EXPIRY=300000

# Application
VITE_APP_NAME=LRQA v2.0
VITE_APP_VERSION=2.0.0
VITE_ENVIRONMENT=development
